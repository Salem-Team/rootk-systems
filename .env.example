# ─────────────────────────────────────────────
# ROOTK Internal HR — Frontend ↔ Backend config
# Copy to .env.local and adjust as needed.
# Backend: NestJS + Prisma + PostgreSQL (see /backend)
# ─────────────────────────────────────────────

# NestJS API base URL (include /api prefix)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Data source:
#   local → LocalStorage + repositories (default demo mode)
#   api   → Real HTTP calls via src/api/* + HttpClient → NestJS
NEXT_PUBLIC_DATA_SOURCE=api

# Multi-tenant company id sent as X-Company-Id (fallback).
# Nest should prefer companyId from JWT claims for writes.
NEXT_PUBLIC_COMPANY_ID=cmp_rootk_001

# Native Capacitor live URL (host that serves the Next.js CRM).
# Required for device/emulator builds. Do not leave a development URL in store binaries.
# CAPACITOR_SERVER_URL=

# ── Backend only (backend/.env) — not used by Next.js ──
# DATABASE_URL=postgresql://rootk:rootk@localhost:5432/rootk_hr?schema=public
# JWT_SECRET=change-me-in-production
# PORT=3001
