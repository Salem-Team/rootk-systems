# ROOTK HR API — NestJS + Prisma + PostgreSQL
# Copy to backend/.env

PORT=3001
DATABASE_URL=postgresql://rootk:rootk@localhost:5432/rootk_hr?schema=public
JWT_SECRET=rootk-dev-secret-change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=365d
CORS_ORIGIN=http://localhost:3010,http://127.0.0.1:3010
DEFAULT_COMPANY_ID=cmp_rootk_001

# Must match frontend NEXT_PUBLIC_ROOTK_EDGE_ID (EdgeGuard).
ROOTK_EDGE_ID=rootk-systems-62

# Website → CRM lead ingest (shared secret with Rootk Website)
# CRM_WEBSITE_INGEST_KEY=
