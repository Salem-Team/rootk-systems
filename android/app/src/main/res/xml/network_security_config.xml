<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Store builds must not allow cleartext. Dev HTTP shells are blocked here. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
